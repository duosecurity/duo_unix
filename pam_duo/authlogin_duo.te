module authlogin_duo 2.2.0;

## <desc>
##  <p>
##  Allow sshd to use the pam_duo PAM module.
##  </p>
## </desc>
gen_tunable(pam_duo_permit_sshd, true)

## <desc>
##  <p>
##  Allow local logins to use the pam_duo PAM module.
##  </p>
## </desc>
gen_tunable(pam_duo_permit_local_login, false)

gen_require(`
    type http_cache_port_t;
    type http_port_t;
    type local_login_t;
    type squid_port_t;
    type sshd_t;
    class tcp_socket name_connect;
    ')

# OpenSSH < 9.8: PAM runs directly in the sshd process
tunable_policy(`pam_duo_permit_sshd',`
    allow sshd_t {http_port_t http_cache_port_t squid_port_t}:tcp_socket name_connect;
')

tunable_policy(`pam_duo_permit_local_login',`
    allow local_login_t {http_port_t http_cache_port_t squid_port_t}:tcp_socket name_connect;
')

# OpenSSH 9.8+: PAM runs in the sshd-session child process (sshd_session_t)
optional_policy(`
    gen_require(`
        type sshd_session_t;
    ')
    tunable_policy(`pam_duo_permit_sshd',`
        allow sshd_session_t {http_port_t http_cache_port_t}:tcp_socket name_connect;
    ')
')

# OpenSSH 10.0+: PAM authentication may run in sshd-auth (sshd_auth_t)
optional_policy(`
    gen_require(`
        type sshd_auth_t;
    ')
    tunable_policy(`pam_duo_permit_sshd',`
        allow sshd_auth_t {http_port_t http_cache_port_t}:tcp_socket name_connect;
    ')
')
